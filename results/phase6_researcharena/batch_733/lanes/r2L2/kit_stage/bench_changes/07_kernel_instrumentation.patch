+# Benchmark change 07 (control-loop, owner 2026-10-24): instrumentation only. The wrappers below swallow kernel
+# exceptions and fall back to PyTorch, and decode-step attention always runs PyTorch SDPA by design, so "injected"
+# never showed which kernels ran. Every wrapped op now counts its custom-kernel calls and its fallbacks (the first
+# exception per op is kept), and decode-step attention is counted as PyTorch. Return values are unchanged; nothing here
+# feeds the score or the correctness check. bench.py resets and reports the counts around each timed benchmark.
+KERNEL_COUNTS = {}
+FIRST_FALLBACK = {}
+
+
+def reset_kernel_counts():
+    KERNEL_COUNTS.clear(); FIRST_FALLBACK.clear()
+    for name in ("rmsnorm", "fused_mlp", "rotary_embedding"):
+        KERNEL_COUNTS[name] = {"custom": 0, "fallback": 0}
+    KERNEL_COUNTS["attention"] = {"custom": 0, "fallback": 0, "decode_pytorch": 0}
+
+
+def _count_fallback(name, exc):
+    KERNEL_COUNTS[name]["fallback"] += 1
+    FIRST_FALLBACK.setdefault(name, repr(exc)[:300])
+
+
+reset_kernel_counts()
+
 
 def _has(agent_ops, name: str) -> bool:
     return hasattr(agent_ops, name)
